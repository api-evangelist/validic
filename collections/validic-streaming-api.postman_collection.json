          "id": "d9a48ac6-b709-44e3-9df0-170b10481a8a",
          "name": "Connect to a stream (SSE)",
          "request": {
            "name": "Connect to a stream (SSE)",
            "description": {
              "content": "Opens a long-lived HTTP connection and streams organization-wide health events using Server-Sent Events (Content-Type text/event-stream). Data events carry health records; a poke (heartbeat) event is sent every 5 seconds. Events are distributed across up to 3 concurrent client connections. This is SSE over HTTPS, not a WebSocket. Served on https://streams.v2.validic.com.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
